# ---- KiCad ----

# Temporary / lock files
*.lck
~*.lck
*.tmp
_autosave-*
*.autosave
*-save.kicad_pcb
*-save.kicad_sch
*-save.pro
*.kicad_prl

# Backups
*-backups/
*.bak
*.kicad_pcb-bak
*.kicad_sch-bak
*.sch-bak
*.pro-bak
*.000
*.net-bak

# Footprint/symbol caches
fp-info-cache
sym-lib-table-bak
fp-lib-table-bak

# Exported / generated output
*.drl
*.gbr
*.gbrjob
*.ps
*.gz
*.zip
gerbers/
jlcpcb/
production/

# Simulation
*.raw
spice/

# KiCad local history (KiCad manages its own repo in here)
.history/

# ---- Editors / OS ----
.vscode/
.idea/
Thumbs.db
desktop.ini
.DS_Store

# Python
__pycache__/
*.pyc

# Playwright MCP scratch output
.playwright-mcp/

# ---- PlatformIO / Arduino ----
.pio/
.pioenvs/
.piolibdeps/
sw/**/build/

# Office lock files
~$*

# ---- KiCad generated outputs (regenerate; do not commit) ----

# Fabrication & assembly
*.pos
*.d356
*.ipc
*.xao

# Netlists and component lists - rebuilt from the schematic
*.net
*.cmp

# Reports (DRC, ERC, footprint mismatch)
*.rpt

# Autorouter round-trip
*.dsn
*.ses

# 3D model exports
*.step
*.stp
*.wrl
*.stl

# Plots. hw/export/ is committed on purpose - keep it visible.
*.svg
!hw/export/**

# ---- Tooling ----

# Python virtualenvs
.venv/
venv/
env/
*.pyo
*.egg-info/

# Node
node_modules/

# Logs and merge leftovers
*.log
*.orig
*.rej

# LibreOffice lock files
.~lock.*#

# Claude Code machine-local settings (share .claude/settings.json, not this)
.claude/settings.local.json
